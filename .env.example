# Safe local defaults. See the operations/SEO runbooks before production activation.
# CMS routes require both settings; never point development at a production database.
DATABASE_URL=
PAYLOAD_SECRET=
CMS_ENABLED=false
# Optional whole hours (1–8760). Blank leaves stock review manual.
# Once configured, unconfirmed/stale stock cannot receive new reservations.
INVENTORY_FRESHNESS_HOURS=
SITE_URL=http://127.0.0.1:3004
# Keep demo until the reviewed catalogue is ready. cms never falls back to fixtures.
CATALOGUE_SOURCE=demo
# Confirmed receiving inbox; a sending provider is NOT configured by this setting.
ENQUIRY_NOTIFICATION_TO=mohamed.sorour8@icloud.com

# Approved public business contact information, E.164 format (+countrycode...).
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
# Supply only documented, client-approved relationship wording and evidence.
WIKA_RELATIONSHIP_EN=
WIKA_RELATIONSHIP_AR=
WIKA_EVIDENCE_URL=

# Delivery stays disabled until sender verification and a controlled smoke test.
# MAIL_FROM is a plain address on a domain verified with the provider.
NOTIFICATION_DELIVERY_ENABLED=false
# Additional switch for customer confirmation delivery.
VERIFICATION_DELIVERY_ENABLED=false
# Public intake remains off until reviewed CMS mode, verified sender and BOTH workers work.
PUBLIC_ENQUIRIES_ENABLED=false
# Operator assertion after scheduling + delivery/retry tests, not automatic detection.
ENQUIRY_WORKERS_READY=false
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=
# Separate random secret (32+ characters), never a staff password.
NOTIFICATION_WORKER_SECRET=

# Enable only after approved content and launch checks; ignored in demo/preview.
SITE_INDEXING_ENABLED=false
# Optional Search Console ownership token (provided by the site owner).
GOOGLE_SITE_VERIFICATION=
# Scheduled delivery/maintenance endpoint; needs a real scheduler and fresh checks.
DELIVERY_OPERATIONS_ENABLED=false
DELIVERY_RETENTION_ENABLED=false
CRON_SECRET=
# Password-reset emails require the verified sender above.
STAFF_RECOVERY_ENABLED=false
# Verified customers may upload up to three private JPEG/PNG photos, 2 MB each.
ENQUIRY_PHOTOS_ENABLED=false
# Existing quotations: private PDF/XLSX/JPEG/PNG, 3 files of 2 MiB each.
# Also requires every customer intake and real email/worker readiness gate.
ENQUIRY_QUOTATIONS_ENABLED=false
# First-party opt-in product metrics. Requires reviewed analytics migration and
# scheduled expiry cleanup. Keep false on preview deployments and until release.
PRODUCT_ANALYTICS_ENABLED=false
